---
import ChapterProgressToggle from '../components/ChapterProgressToggle.astro';
import SolutionReveal from '../components/SolutionReveal.astro';
import {
  type ChapterMeta,
  formatModelRequirement,
  getAdjacentChapters,
  getChapterUrl,
} from '../lib/chapter-utils';
import type { LoadedSolutionFile } from '../lib/solutions';
import BaseLayout from './BaseLayout.astro';

interface HeadingItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  chapter: ChapterMeta;
  allChapters: ChapterMeta[];
  headings: HeadingItem[];
  loadedSolutions: LoadedSolutionFile[];
}

const { chapter, allChapters, headings, loadedSolutions } = Astro.props;

const chapterHeadingPrefix =
  chapter.part === 'appendix' ? `付録 ${chapter.chapterNumber}` : `第 ${chapter.chapterNumber} 章`;
const fullHeading = `${chapterHeadingPrefix}　${chapter.title}`;
const pageTitle = `${chapterHeadingPrefix} ${chapter.title}`;
const { prev, next } = getAdjacentChapters(allChapters, chapter.slug);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const allSlugsJson = JSON.stringify(allChapters.map((c) => c.slug));
const practiceAppUrl = 'https://test-automation-practice-app.rymetry.workers.dev';

function formatShortLabel(item: ChapterMeta): string {
  return item.part === 'appendix'
    ? `付録 ${item.chapterNumber}`
    : `第 ${item.chapterNumber} 章`;
}
---

<BaseLayout title={pageTitle} description={chapter.summary} isHome={false}>
  <div class="chapter-shell lab-container">
    <!-- Mobile chapter drawer bar (< 1024px) -->
    <div class="mobile-chapter-bar" data-pagefind-ignore>
      <details class="mobile-chapter-drawer">
        <summary class="mobile-drawer-summary">
          <span>章一覧を開く</span>
          <span class="mobile-drawer-current">{chapterHeadingPrefix}</span>
        </summary>
        <nav class="mobile-drawer-nav" aria-label="章ナビゲーション（モバイル）">
          <ul class="sidebar-nav-list">
            {allChapters.map((item) => (
              <>
                <li>
                  <a
                    href={getChapterUrl(item.slug)}
                    class:list={['sidebar-link', { 'is-active': item.slug === chapter.slug }]}
                    aria-current={item.slug === chapter.slug ? 'page' : undefined}
                    data-sidebar-slug={item.slug}
                  >
                    <span class="sidebar-check" data-sidebar-check={item.slug} aria-hidden="true"></span>
                    <span class="sidebar-num tabular-nums">
                      {item.part === 'appendix' ? item.chapterNumber : item.chapterNumber}
                    </span>
                    <span class="sidebar-title">{item.title}</span>
                  </a>
                </li>
                {item.order === 0 && (
                  <li class="sidebar-setup-row">
                    <a href="/setup/" class="sidebar-link sidebar-setup-link">
                      <span class="sidebar-setup-mark" aria-hidden="true">→</span>
                      <span class="sidebar-title">環境セットアップ</span>
                    </a>
                  </li>
                )}
              </>
            ))}
          </ul>
        </nav>
      </details>
    </div>

    <div class="chapter-grid">
      <!-- Left sidebar (>= 1024px) -->
      <aside class="chapter-sidebar" aria-label="章ナビゲーション" data-pagefind-ignore>
        <div class="sidebar-sticky">
          <div class="sidebar-header">
            <a href="/curriculum/" class="sidebar-heading-link">カリキュラム</a>
            <span
              class="sidebar-progress tabular-nums"
              data-sidebar-progress
              data-all-slugs={allSlugsJson}
            >
              0 / {allChapters.length}
            </span>
          </div>

          <nav aria-label="全章リスト">
            <ul class="sidebar-nav-list">
              {allChapters.map((item) => (
                <>
                  <li>
                    <a
                      href={getChapterUrl(item.slug)}
                      class:list={['sidebar-link', { 'is-active': item.slug === chapter.slug }]}
                      aria-current={item.slug === chapter.slug ? 'page' : undefined}
                      data-sidebar-slug={item.slug}
                    >
                      <span class="sidebar-check" data-sidebar-check={item.slug} aria-hidden="true"></span>
                      <span class="sidebar-num tabular-nums">{item.chapterNumber}</span>
                      <span class="sidebar-title">{item.title}</span>
                    </a>
                  </li>
                  {item.order === 0 && (
                    <li class="sidebar-setup-row">
                      <a href="/setup/" class="sidebar-link sidebar-setup-link">
                        <span class="sidebar-setup-mark" aria-hidden="true">→</span>
                        <span class="sidebar-title">環境セットアップ</span>
                      </a>
                    </li>
                  )}
                </>
              ))}
            </ul>
          </nav>
        </div>
      </aside>

      <!-- Center article -->
      <article class="chapter-article">
        <header class="chapter-header">
          <h1 class="chapter-h1">{fullHeading}</h1>
          <div class="chapter-meta-row tabular-nums">
            <span>目安 {chapter.estimatedMinutes} 分</span>
            <span class="meta-sep" aria-hidden="true">/</span>
            <span>{formatModelRequirement(chapter.modelRequirement)}</span>
            <span class="meta-sep" aria-hidden="true">/</span>
            <span class="meta-mono">e2e {chapter.e2eVersion ?? '0.25.0'}</span>
          </div>
        </header>

        {tocHeadings.length > 0 && (
          <details class="inline-toc" data-pagefind-ignore>
            <summary class="inline-toc-summary">On this page</summary>
            <ul class="toc-list">
              {tocHeadings.map((heading) => (
                <li class:list={['toc-item', { 'toc-item-sub': heading.depth === 3 }]}>
                  <a href={`#${heading.slug}`} class="toc-link">{heading.text}</a>
                </li>
              ))}
            </ul>
          </details>
        )}

        <div class="chapter-prose">
          <slot />
        </div>

        <SolutionReveal files={loadedSolutions} />

        <ChapterProgressToggle slug={chapter.slug} chapterLabel={chapterHeadingPrefix} />

        <nav class="chapter-pagination" aria-label="前後の章" data-pagefind-ignore>
          {prev ? (
            <a href={getChapterUrl(prev.slug)} class="page-nav-link page-nav-prev">
              <span class="page-nav-dir">前の章</span>
              <span class="page-nav-title">
                {formatShortLabel(prev)}　{prev.title}
              </span>
            </a>
          ) : (
            <a href="/curriculum/" class="page-nav-link page-nav-prev">
              <span class="page-nav-dir">一覧へ</span>
              <span class="page-nav-title">カリキュラム一覧</span>
            </a>
          )}

          {next ? (
            <a href={getChapterUrl(next.slug)} class="page-nav-link page-nav-next">
              <span class="page-nav-dir">次の章</span>
              <span class="page-nav-title">
                {formatShortLabel(next)}　{next.title}
              </span>
            </a>
          ) : (
            <a href="/reference/" class="page-nav-link page-nav-next">
              <span class="page-nav-dir">次へ</span>
              <span class="page-nav-title">クイックリファレンス</span>
            </a>
          )}
        </nav>
      </article>

      <!-- Right sidebar (>= 1280px) -->
      <aside class="chapter-toc-rail" aria-label="目次とクイックツール" data-pagefind-ignore>
        <div class="toc-sticky">
          {tocHeadings.length > 0 && (
            <div class="toc-section">
              <p class="rail-title">On this page</p>
              <ul class="toc-list" data-toc-spy>
                {tocHeadings.map((heading) => (
                  <li class:list={['toc-item', { 'toc-item-sub': heading.depth === 3 }]}>
                    <a href={`#${heading.slug}`} class="toc-link" data-toc-link={heading.slug}>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <div class="rail-tools">
            <p class="rail-title">練習用アプリと補助リンク</p>
            <ul class="rail-tool-list">
              <li>
                <a
                  href={practiceAppUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="rail-tool-link"
                >
                  練習用アプリを開く ↗
                </a>
              </li>
              <li>
                <button
                  type="button"
                  class="rail-copy-btn"
                  data-copy-app-url={practiceAppUrl}
                >
                  URL をコピー
                </button>
                <span class="copy-feedback" data-copy-feedback aria-live="polite"></span>
              </li>
              <li>
                <a href="/errors/" class="rail-tool-link">エラーコード逆引き</a>
              </li>
              <li>
                <a href="/reference/" class="rail-tool-link">クイックリファレンス</a>
              </li>
            </ul>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .chapter-shell {
    padding-top: 1.5rem;
    padding-bottom: 3rem;
  }

  /* Mobile drawer (< 1024px) */
  .mobile-chapter-bar {
    margin-bottom: 1.25rem;
  }

  .mobile-chapter-drawer {
    border: 1px solid var(--border-hairline);
    border-radius: 4px;
    background-color: var(--bg-elevated);
  }

  .mobile-drawer-summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 0.875rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    background-color: var(--bg-surface);
  }

  .mobile-drawer-summary::-webkit-details-marker {
    display: none;
  }

  .mobile-drawer-current {
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .mobile-drawer-nav {
    border-top: 1px solid var(--border-hairline);
    max-height: 60vh;
    overflow-y: auto;
    padding: 0.5rem 0;
  }

  /* Responsive 1 -> 2 -> 3 column workspace */
  .chapter-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .chapter-sidebar,
  .chapter-toc-rail {
    display: none;
  }

  .sidebar-sticky,
  .toc-sticky {
    position: sticky;
    top: 5rem;
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
  }

  .sidebar-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.625rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-hairline);
  }

  .sidebar-heading-link {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
  }

  .sidebar-heading-link:hover {
    color: var(--accent);
  }

  .sidebar-progress {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .sidebar-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .sidebar-link {
    display: grid;
    grid-template-columns: 14px 24px minmax(0, 1fr);
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.375rem 0.5rem 0.375rem 0.625rem;
    border-left: 2px solid transparent;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 160ms var(--ease-precision), background-color 160ms var(--ease-precision), border-color 160ms var(--ease-precision);
  }

  .sidebar-link:hover {
    color: var(--text-primary);
    background-color: var(--bg-surface);
  }

  .sidebar-link.is-active {
    border-left-color: var(--accent);
    background-color: var(--bg-surface);
    color: var(--text-primary);
    font-weight: 600;
  }

  .sidebar-check {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    text-align: center;
  }

  .sidebar-num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .sidebar-link.is-active .sidebar-num {
    color: var(--accent);
  }

  .sidebar-title {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sidebar-setup-row {
    margin-block: 0.25rem;
    padding-block: 0.25rem;
    border-top: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
  }

  .sidebar-setup-link {
    grid-template-columns: 14px minmax(0, 1fr);
    color: var(--text-primary);
    font-weight: 500;
  }

  .sidebar-setup-mark {
    font-family: var(--font-mono);
    color: var(--accent);
  }

  /* Center article header (ZERO eyebrow above h1) */
  .chapter-article {
    min-width: 0;
  }

  .chapter-header {
    max-width: 65ch;
    margin-bottom: 1.75rem;
  }

  .chapter-h1 {
    margin: 0 0 0.875rem;
    font-size: clamp(1.625rem, 3vw, 2.125rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--text-primary);
    text-wrap: balance;
  }

  .chapter-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    padding-block: 0.625rem;
    border-top: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .meta-sep {
    color: var(--border-hairline);
  }

  .meta-mono {
    font-family: var(--font-mono);
  }

  /* Collapsible inline TOC (< 1280px) */
  .inline-toc {
    max-width: 65ch;
    margin-bottom: 1.75rem;
    border: 1px solid var(--border-hairline);
    border-radius: 4px;
    background-color: var(--bg-surface);
  }

  .inline-toc-summary {
    list-style: none;
    padding: 0.625rem 0.875rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
  }

  .inline-toc-summary::-webkit-details-marker {
    display: none;
  }

  .inline-toc .toc-list {
    padding: 0.5rem 0.875rem 0.875rem;
    border-top: 1px solid var(--border-hairline);
  }

  /* TOC & Right rail */
  .rail-title {
    margin: 0 0 0.625rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--text-primary);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    margin-bottom: 0.375rem;
  }

  .toc-item-sub {
    padding-left: 0.875rem;
  }

  .toc-link {
    display: block;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 160ms var(--ease-precision);
  }

  .toc-link:hover,
  .toc-link.is-active {
    color: var(--accent);
  }

  .toc-link.is-active {
    font-weight: 600;
  }

  .rail-tools {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-hairline);
  }

  .rail-tool-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .rail-tool-link,
  .rail-copy-btn {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-decoration: none;
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-align: left;
    transition: color 160ms var(--ease-precision);
  }

  .rail-tool-link:hover,
  .rail-copy-btn:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .copy-feedback {
    display: inline-block;
    margin-left: 0.5rem;
    font-size: var(--text-sm);
    color: var(--accent);
  }

  /* Prev / Next pagination */
  .chapter-pagination {
    margin-top: 2rem;
    max-width: 65ch;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
  }

  .page-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--border-hairline);
    border-radius: 4px;
    background-color: var(--bg-elevated);
    text-decoration: none;
    transition: border-color 160ms var(--ease-precision), background-color 160ms var(--ease-precision);
  }

  .page-nav-link:hover {
    border-color: var(--accent);
    background-color: var(--bg-surface);
  }

  .page-nav-dir {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .page-nav-title {
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--text-primary);
  }

  @media (min-width: 640px) {
    .chapter-pagination {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .page-nav-next {
      text-align: right;
    }
  }

  @media (min-width: 1024px) {
    .mobile-chapter-bar {
      display: none;
    }

    .chapter-sidebar {
      display: block;
      border-right: 1px solid var(--border-hairline);
      padding-right: 1.25rem;
    }

    .chapter-grid {
      grid-template-columns: 248px minmax(0, 1fr);
      gap: 2.5rem;
    }
  }

  @media (min-width: 1280px) {
    .inline-toc {
      display: none;
    }

    .chapter-toc-rail {
      display: block;
      border-left: 1px solid var(--border-hairline);
      padding-left: 1.25rem;
    }

    .chapter-grid {
      grid-template-columns: 248px minmax(0, 1fr) 216px;
      gap: 2.5rem;
    }
  }
</style>

<script>
  import { calculateProgress } from '../lib/chapter-utils';
  import { loadProgress } from '../lib/progress-store';

  function refreshSidebarProgress() {
    const state = loadProgress();
    const completedSet = new Set(state.completed);

    for (const checkEl of document.querySelectorAll<HTMLElement>('[data-sidebar-check]')) {
      const slug = checkEl.dataset.sidebarCheck;
      checkEl.textContent = slug && completedSet.has(slug) ? '✓' : '';
    }

    const progressEl = document.querySelector<HTMLElement>('[data-sidebar-progress]');
    if (progressEl && progressEl.dataset.allSlugs) {
      try {
        const allSlugs = JSON.parse(progressEl.dataset.allSlugs) as string[];
        const summary = calculateProgress(allSlugs, completedSet);
        progressEl.textContent = `${summary.completed} / ${summary.total}`;
      } catch {
        // Ignore malformed attribute
      }
    }
  }

  refreshSidebarProgress();
  window.addEventListener('e2e-progress-change', refreshSidebarProgress);

  // Copy practice app URL
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-copy-app-url]');
  const feedbackEl = document.querySelector<HTMLElement>('[data-copy-feedback]');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const url = copyBtn.dataset.copyAppUrl ?? '';
      try {
        await navigator.clipboard.writeText(url);
        if (feedbackEl) {
          feedbackEl.textContent = 'コピーしました';
          window.setTimeout(() => {
            feedbackEl.textContent = '';
          }, 2000);
        }
      } catch {
        if (feedbackEl) {
          feedbackEl.textContent = 'コピーに失敗しました';
        }
      }
    });
  }

  // Lightweight TOC scroll spy
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  if (tocLinks.length > 0 && 'IntersectionObserver' in window) {
    const targetMap = new Map<string, HTMLAnchorElement>();
    const headingEls: HTMLElement[] = [];

    for (const link of tocLinks) {
      const slug = link.dataset.tocLink;
      if (!slug) continue;
      const target = document.getElementById(slug);
      if (target) {
        targetMap.set(slug, link);
        headingEls.push(target);
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            for (const link of tocLinks) {
              link.classList.remove('is-active');
            }
            const active = targetMap.get(entry.target.id);
            if (active) active.classList.add('is-active');
          }
        }
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
    );

    for (const el of headingEls) {
      observer.observe(el);
    }
  }
</script>
