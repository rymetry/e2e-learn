---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SearchModal from '../components/SearchModal.astro';
import { buildCanonicalUrl, isPreviewBuild } from '../lib/site-env';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}

const {
  title,
  description = 'e2e inc. のエージェント型 E2E テストフレームワークをゼロから実務レベルまで学べる日本語ハンズオン教材（全 16 章・e2e 0.25.0 対応）。',
  isHome = false,
} = Astro.props;

const siteBase = Astro.site ?? new URL('https://e2e-learn.rymetry.workers.dev');
const pageTitle = isHome
  ? 'e2e Zero to Hero | e2e inc. 実践ハンズオン'
  : `${title ?? 'ハンズオン'} | e2e Zero to Hero`;
const canonicalUrl = buildCanonicalUrl(Astro.url.pathname, siteBase);
const ogImageUrl = new URL('/ogp.png', siteBase).toString();
const previewBuild = isPreviewBuild(process.env);
---

<!doctype html>
<html lang="ja" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {previewBuild && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={isHome ? 'website' : 'article'} />
    <meta property="og:site_name" content="e2e Zero to Hero" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;700&family=IBM+Plex+Sans+JP:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      (() => {
        const key = 'e2e-learn:theme';
        let theme = null;
        try {
          const saved = localStorage.getItem(key);
          if (saved === 'light' || saved === 'dark') {
            theme = saved;
          }
        } catch {
          // Ignore storage access failure
        }
        if (!theme) {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">本文へスキップ</a>
    <Header isHome={isHome} currentPath={Astro.url.pathname} />
    <main id="main-content" data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <SearchModal />
  </body>
</html>
