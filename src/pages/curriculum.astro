---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatModelRequirement, getChapterUrl } from '../lib/chapter-utils';
import { getAllChapters, toChapterMeta } from '../lib/chapters';

const entries = await getAllChapters();
const chapters = entries.map(toChapterMeta);
const totalMinutes = chapters.reduce((acc, ch) => acc + ch.estimatedMinutes, 0);

const clientChaptersJson = JSON.stringify(
  chapters.map((ch) => ({
    slug: ch.slug,
    order: ch.order,
    chapterNumber: ch.chapterNumber,
    part: ch.part,
    modelRequirement: ch.modelRequirement,
    estimatedMinutes: ch.estimatedMinutes,
  })),
);

const part2Preview = [
  { num: '15', title: 'モバイルテスト環境構築（Expo）' },
  { num: '16', title: 'iOS・Android シミュレータでの操作と検証' },
  { num: '17', title: 'クロスプラットフォーム構成と CI 実行' },
];
---

<BaseLayout
  title="カリキュラム"
  description="e2e Zero to Hero の全 16 章（第 00〜14 章・付録 A）ロードマップ、学習進捗管理、AI モデル要否フィルタ。"
  isHome={false}
>
  <div class="workspace-page lab-container">
    <header class="workspace-header">
      <h1 class="workspace-h1">カリキュラム</h1>
      <p class="workspace-desc">
        Part 1（全 15 章）と付録 A を合わせて全 16 章の構成です。第 05 章までは AI モデル不要で完走できます。
      </p>
    </header>

    <!-- Progress summary strip -->
    <section
      class="progress-summary"
      aria-label="学習進捗サマリー"
      data-curriculum-root
      data-chapters={clientChaptersJson}
    >
      <div class="progress-top-row">
        <div class="progress-stats tabular-nums">
          <span class="progress-count" data-progress-count>0 / {chapters.length} 章完了（0%）</span>
          <span class="meta-sep" aria-hidden="true">/</span>
          <span class="progress-remaining" data-progress-remaining>
            推定残り時間 約 {totalMinutes} 分
          </span>
        </div>

        <div class="progress-actions">
          <a href="/chapters/00-typescript-basics/" class="lab-link resume-link" data-resume-link hidden>
            続きから再開 →
          </a>
          <button type="button" class="reset-trigger" data-reset-trigger hidden>
            進捗をリセット
          </button>
          <span class="reset-confirm" data-reset-confirm hidden>
            <span>記録を初期化しますか？</span>
            <button type="button" class="reset-yes" data-reset-yes>実行</button>
            <button type="button" class="reset-cancel" data-reset-cancel>キャンセル</button>
          </span>
        </div>
      </div>

      <div class="progress-bar-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" data-progress-bar>
        <div class="progress-bar-fill" data-progress-fill style="width: 0%"></div>
      </div>
    </section>

    <!-- Segmented Filter (non-button selection control) -->
    <div class="filter-bar">
      <div class="segmented-control" role="radiogroup" aria-label="章の絞り込み">
        <button type="button" role="radio" aria-checked="true" data-filter="all">すべて</button>
        <button type="button" role="radio" aria-checked="false" data-filter="no-model">モデル不要</button>
        <button type="button" role="radio" aria-checked="false" data-filter="uses-model">AI モデル使用</button>
        <button type="button" role="radio" aria-checked="false" data-filter="incomplete">未完了</button>
      </div>
      <span class="filter-count tabular-nums" data-filter-count aria-live="polite">
        全 {chapters.length} 章を表示中
      </span>
    </div>

    <!-- Part 1 + Appendix A Hairline List -->
    <section aria-label="Part 1 および付録 A の章一覧">
      <div class="chapter-list" data-chapter-list>
        {chapters.map((ch) => (
          <>
            <div class="chapter-row" data-chapter-row={ch.slug}>
              <div class="chapter-row-check">
                <input
                  type="checkbox"
                  id={`curr-check-${ch.slug}`}
                  class="chapter-checkbox"
                  data-curriculum-checkbox={ch.slug}
                  aria-label={`${ch.part === 'appendix' ? `付録 ${ch.chapterNumber}` : `第 ${ch.chapterNumber} 章`} ${ch.title} を完了にする`}
                />
              </div>

              <div class="chapter-row-num tabular-nums">
                {ch.part === 'appendix' ? `付録 ${ch.chapterNumber}` : `第 ${ch.chapterNumber} 章`}
              </div>

              <div class="chapter-row-main">
                <a href={getChapterUrl(ch.slug)} class="chapter-row-link">
                  {ch.title}
                </a>
                <p class="chapter-row-summary">{ch.summary}</p>
              </div>

              <div class="chapter-row-meta tabular-nums">
                <span>{formatModelRequirement(ch.modelRequirement)}</span>
                <span class="meta-sep" aria-hidden="true">/</span>
                <span>約 {ch.estimatedMinutes} 分</span>
              </div>
            </div>

            {ch.order === 0 && (
              <div class="chapter-row setup-guide-row" data-setup-row>
                <div class="chapter-row-check" aria-hidden="true">→</div>
                <div class="chapter-row-num">準備</div>
                <div class="chapter-row-main">
                  <a href="/setup/" class="chapter-row-link">
                    環境セットアップ（my-e2e-hands-on/ の初期構築）
                  </a>
                  <p class="chapter-row-summary">
                    TypeScript 経験者はここから開始できます。e2e.config.ts の完全テンプレートと初回スモークテストを 3 ステップで完了します。
                  </p>
                </div>
                <div class="chapter-row-meta tabular-nums">
                  <span>モデル不要</span>
                  <span class="meta-sep" aria-hidden="true">/</span>
                  <span>約 10 分</span>
                </div>
              </div>
            )}
          </>
        ))}
      </div>

      <p class="empty-message" data-empty-message hidden>
        条件に一致する章がありません。絞り込みを「すべて」に戻すと全 16 章が表示されます。
      </p>
    </section>

    <!-- Quiet Part 2 Preview (plain text, zero disabled buttons/badges) -->
    <section class="part2-section" aria-labelledby="part2-heading">
      <h2 id="part2-heading" class="lab-heading">Part 2 モバイルテスト（Expo）</h2>
      <p class="part2-note">
        モバイルアプリ向け E2E テストの続編パートは現在執筆を進めています。
      </p>
      <div class="part2-list">
        {part2Preview.map((item) => (
          <div class="part2-row">
            <span class="part2-num tabular-nums">第 {item.num} 章</span>
            <span class="part2-title">{item.title}</span>
            <span class="part2-status">準備中</span>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .workspace-page {
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  .workspace-header {
    margin-bottom: 1.75rem;
  }

  .workspace-h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.75rem, 3.2vw, 2.25rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.025em;
    color: var(--text-primary);
  }

  .workspace-desc {
    margin: 0;
    max-width: 65ch;
    color: var(--text-muted);
  }

  .progress-summary {
    padding: 1rem 1.125rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-hairline);
    border-radius: 4px;
    margin-bottom: 1.5rem;
  }

  .progress-top-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    margin-bottom: 0.75rem;
  }

  .progress-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.625rem;
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .progress-count {
    font-weight: 600;
  }

  .progress-remaining {
    color: var(--text-muted);
  }

  .meta-sep {
    color: var(--border-hairline);
  }

  .progress-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
    font-size: var(--text-sm);
  }

  .resume-link {
    font-weight: 600;
  }

  .reset-trigger,
  .reset-yes,
  .reset-cancel {
    background: transparent;
    border: 0;
    padding: 0;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .reset-trigger,
  .reset-cancel {
    color: var(--text-muted);
  }

  .reset-yes {
    color: var(--semantic-fail);
    font-weight: 600;
  }

  .reset-confirm {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--text-muted);
  }

  .reset-confirm[hidden],
  .reset-trigger[hidden],
  .resume-link[hidden] {
    display: none;
  }

  .progress-bar-track {
    width: 100%;
    height: 6px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-hairline);
    border-radius: 999px;
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background-color: var(--accent);
    transition: width 200ms var(--ease-precision);
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-bottom: 1.25rem;
  }

  .filter-count {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .chapter-list {
    border-top: 1px solid var(--border-hairline);
  }

  .chapter-row {
    display: grid;
    grid-template-columns: 28px 5.5rem minmax(0, 1fr);
    gap: 0.5rem 0.875rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--border-hairline);
    align-items: baseline;
  }

  .chapter-row[hidden] {
    display: none;
  }

  .setup-guide-row {
    background-color: var(--bg-surface);
    padding-inline: 0.75rem;
  }

  .chapter-row-check {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    color: var(--accent);
  }

  .chapter-checkbox {
    width: 16px;
    height: 16px;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .chapter-row-num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }

  .chapter-row-main {
    min-width: 0;
  }

  .chapter-row-link {
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--text-primary);
    text-decoration: none;
    transition: color 160ms var(--ease-precision);
  }

  .chapter-row-link:hover {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .chapter-row-summary {
    margin: 0.25rem 0 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
    max-width: 62ch;
  }

  .chapter-row-meta {
    grid-column: 2 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.5rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .empty-message {
    padding: 2rem 0;
    color: var(--text-muted);
  }

  /* Quiet Part 2 */
  .part2-section {
    margin-top: 3.5rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border-hairline);
  }

  .part2-section h2 {
    margin: 0 0 0.5rem;
  }

  .part2-note {
    margin: 0 0 1.25rem;
    color: var(--text-muted);
  }

  .part2-list {
    border-top: 1px solid var(--border-hairline);
  }

  .part2-row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    gap: 0.75rem 1rem;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--border-hairline);
    color: var(--text-muted);
    align-items: baseline;
  }

  .part2-num {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .part2-title {
    font-size: var(--text-body);
  }

  .part2-status {
    font-size: var(--text-sm);
  }

  @media (min-width: 860px) {
    .chapter-row {
      grid-template-columns: 28px 5.5rem minmax(0, 1fr) 13.5rem;
      gap: 0.5rem 1.25rem;
    }

    .chapter-row-meta {
      grid-column: auto;
      justify-content: flex-end;
      white-space: nowrap;
    }
  }
</style>

<script>
  import {
    type CurriculumFilter,
    type ModelRequirement,
    calculateProgress,
    filterChapters,
    getChapterUrl,
    getResumeChapter,
  } from '../lib/chapter-utils';
  import {
    loadProgress,
    resetProgress,
    saveProgress,
    toggleChapterCompletion,
  } from '../lib/progress-store';

  interface CurriculumChapterItem {
    slug: string;
    order: number;
    chapterNumber: string;
    part: 'part-1' | 'appendix';
    modelRequirement: ModelRequirement;
    estimatedMinutes: number;
  }

  const root = document.querySelector<HTMLElement>('[data-curriculum-root]');
  if (root && root.dataset.chapters) {
    const chapters = JSON.parse(root.dataset.chapters) as CurriculumChapterItem[];
    const allSlugs = chapters.map((c) => c.slug);

    const countEl = document.querySelector<HTMLElement>('[data-progress-count]');
    const remainingEl = document.querySelector<HTMLElement>('[data-progress-remaining]');
    const barEl = document.querySelector<HTMLElement>('[data-progress-bar]');
    const fillEl = document.querySelector<HTMLElement>('[data-progress-fill]');
    const resumeLink = document.querySelector<HTMLAnchorElement>('[data-resume-link]');
    const resetTrigger = document.querySelector<HTMLButtonElement>('[data-reset-trigger]');
    const resetConfirm = document.querySelector<HTMLElement>('[data-reset-confirm]');
    const resetYes = document.querySelector<HTMLButtonElement>('[data-reset-yes]');
    const resetCancel = document.querySelector<HTMLButtonElement>('[data-reset-cancel]');
    const filterCountEl = document.querySelector<HTMLElement>('[data-filter-count]');
    const emptyEl = document.querySelector<HTMLElement>('[data-empty-message]');
    const setupRow = document.querySelector<HTMLElement>('[data-setup-row]');

    const filterRadios = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-chapter-row]'));
    const checkboxes = Array.from(
      document.querySelectorAll<HTMLInputElement>('[data-curriculum-checkbox]'),
    );

    let activeFilter: CurriculumFilter = 'all';

    function render() {
      const progress = loadProgress();
      const completedSet = new Set(progress.completed);
      const summary = calculateProgress(allSlugs, completedSet);

      const remainingMinutes = chapters
        .filter((ch) => !completedSet.has(ch.slug))
        .reduce((acc, ch) => acc + ch.estimatedMinutes, 0);

      if (countEl) {
        countEl.textContent = `${summary.completed} / ${summary.total} 章完了（${summary.percent}%）`;
      }
      if (remainingEl) {
        remainingEl.textContent =
          remainingMinutes > 0
            ? `推定残り時間 約 ${remainingMinutes} 分`
            : '全 16 章を完了しました';
      }
      if (barEl) {
        barEl.setAttribute('aria-valuenow', String(summary.percent));
      }
      if (fillEl) {
        fillEl.style.width = `${summary.percent}%`;
      }

      if (resumeLink) {
        if (summary.completed > 0) {
          const target = getResumeChapter(chapters, completedSet);
          if (target) {
            const label =
              target.part === 'appendix'
                ? `付録 ${target.chapterNumber}`
                : `第 ${target.chapterNumber} 章`;
            resumeLink.href = getChapterUrl(target.slug);
            resumeLink.textContent = `続きから再開（${label}） →`;
            resumeLink.hidden = false;
          }
        } else {
          resumeLink.hidden = true;
        }
      }

      if (resetTrigger && resetConfirm) {
        if (summary.completed === 0) {
          resetTrigger.hidden = true;
          resetConfirm.hidden = true;
        } else if (resetConfirm.hidden) {
          resetTrigger.hidden = false;
        }
      }

      for (const box of checkboxes) {
        const slug = box.dataset.curriculumCheckbox;
        if (slug) {
          box.checked = completedSet.has(slug);
        }
      }

      const visibleChapters = filterChapters(chapters, activeFilter, completedSet);
      const visibleSlugs = new Set(visibleChapters.map((ch) => ch.slug));

      for (const row of rows) {
        const slug = row.dataset.chapterRow;
        row.hidden = !(slug && visibleSlugs.has(slug));
      }

      if (setupRow) {
        setupRow.hidden = activeFilter !== 'all' && activeFilter !== 'no-model';
      }

      if (filterCountEl) {
        filterCountEl.textContent = `${visibleChapters.length} / ${chapters.length} 章を表示中`;
      }
      if (emptyEl) {
        emptyEl.hidden = visibleChapters.length > 0;
      }
    }

    for (const radio of filterRadios) {
      radio.addEventListener('click', () => {
        const next = radio.dataset.filter as CurriculumFilter | undefined;
        if (!next) return;
        activeFilter = next;
        for (const r of filterRadios) {
          r.setAttribute('aria-checked', String(r === radio));
        }
        render();
      });
    }

    for (const box of checkboxes) {
      box.addEventListener('change', () => {
        const slug = box.dataset.curriculumCheckbox;
        if (!slug) return;
        const current = loadProgress();
        const isDone = current.completed.includes(slug);
        if (isDone !== box.checked) {
          const next = toggleChapterCompletion(current, slug);
          saveProgress(next);
          window.dispatchEvent(new CustomEvent('e2e-progress-change', { detail: next }));
        }
        render();
      });
    }

    if (resetTrigger && resetConfirm && resetYes && resetCancel) {
      resetTrigger.addEventListener('click', () => {
        resetTrigger.hidden = true;
        resetConfirm.hidden = false;
      });
      resetCancel.addEventListener('click', () => {
        resetConfirm.hidden = true;
        resetTrigger.hidden = false;
      });
      resetYes.addEventListener('click', () => {
        resetProgress();
        resetConfirm.hidden = true;
        window.dispatchEvent(new CustomEvent('e2e-progress-change'));
        render();
      });
    }

    render();
  }
</script>
