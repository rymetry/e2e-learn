---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  isHome?: boolean;
  currentPath: string;
}

const { isHome = false, currentPath } = Astro.props;

const navItems = [
  { href: '/curriculum/', label: 'カリキュラム' },
  { href: '/setup/', label: 'セットアップ' },
  { href: '/errors/', label: 'エラー逆引き' },
  { href: '/reference/', label: 'リファレンス' },
];

function isActive(href: string, path: string): boolean {
  if (href === '/curriculum/' && path.startsWith('/chapters/')) {
    return true;
  }
  return path === href || path.startsWith(href);
}
---

<header
  class:list={['site-header', isHome ? 'site-header-home' : 'site-header-workspace']}
  data-site-header
  data-is-home={isHome ? 'true' : 'false'}
  data-pagefind-ignore
>
  <div class="lab-container header-inner">
    <a href="/" class="wordmark" aria-label="e2e Zero to Hero トップページ">
      <span class="wordmark-prefix">e2e</span>
      <span class="wordmark-rest">Zero to Hero</span>
    </a>

    <nav class="desktop-nav" aria-label="メインナビゲーション">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['nav-link', { 'is-active': isActive(item.href, currentPath) }]}
          aria-current={isActive(item.href, currentPath) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <button
        type="button"
        class="search-trigger"
        data-search-open
        aria-label="サイト内検索を開く"
      >
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <span class="search-trigger-label">検索</span>
        <kbd class="search-shortcut" aria-hidden="true">⌘K</kbd>
      </button>

      <ThemeToggle />

      <button
        type="button"
        class="mobile-menu-toggle"
        data-mobile-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label="メニューを開く"
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav-panel" class="mobile-nav-panel" hidden>
    <nav class="lab-container mobile-nav-list" aria-label="モバイルナビゲーション">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={['mobile-nav-link', { 'is-active': isActive(item.href, currentPath) }]}
          aria-current={isActive(item.href, currentPath) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    width: 100%;
    transition: background-color 180ms var(--ease-precision), border-color 180ms var(--ease-precision);
  }

  .site-header-home {
    background-color: transparent;
    border-bottom: 1px solid transparent;
  }

  .site-header-home.is-scrolled {
    background-color: var(--header-scrolled-bg);
    border-bottom-color: var(--border-hairline);
    backdrop-filter: blur(10px);
  }

  .site-header-workspace {
    background-color: var(--header-scrolled-bg);
    border-bottom: 1px solid var(--border-hairline);
    backdrop-filter: blur(10px);
  }

  .header-inner {
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.42rem;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    line-height: 1.1;
  }

  .wordmark-prefix {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--accent);
  }

  .wordmark-rest {
    font-family: var(--font-sans);
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-link {
    position: relative;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
    padding: 0.25rem 0;
    transition: color 160ms var(--ease-precision);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link.is-active {
    color: var(--text-primary);
    font-weight: 600;
  }

  .nav-link.is-active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background-color: var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 36px;
    padding: 0 0.625rem;
    border: 1px solid var(--border-hairline);
    border-radius: 4px;
    background-color: transparent;
    color: var(--text-muted);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: color 160ms var(--ease-precision), border-color 160ms var(--ease-precision), background-color 160ms var(--ease-precision);
  }

  .search-trigger:hover {
    color: var(--text-primary);
    border-color: var(--text-muted);
    background-color: var(--bg-surface);
  }

  .search-trigger-label,
  .search-shortcut {
    display: none;
  }

  .search-shortcut {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .mobile-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid var(--border-hairline);
    border-radius: 4px;
    background-color: transparent;
    color: var(--text-primary);
    cursor: pointer;
    transition: background-color 160ms var(--ease-precision), border-color 160ms var(--ease-precision);
  }

  .mobile-menu-toggle:hover {
    background-color: var(--bg-surface);
  }

  .mobile-nav-panel {
    border-top: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
    background-color: var(--bg-page);
  }

  .mobile-nav-list {
    display: flex;
    flex-direction: column;
    padding-block: 0.5rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.625rem 0;
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--border-hairline);
  }

  .mobile-nav-link:last-child {
    border-bottom: 0;
  }

  .mobile-nav-link.is-active {
    color: var(--accent);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: flex;
    }

    .search-trigger {
      padding: 0 0.75rem;
    }

    .search-trigger-label,
    .search-shortcut {
      display: inline;
    }

    .mobile-menu-toggle,
    .mobile-nav-panel {
      display: none !important;
    }
  }

  @media (max-width: 420px) {
    .wordmark-prefix {
      font-size: 1.125rem;
    }

    .wordmark-rest {
      font-size: 1.0625rem;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header && header.dataset.isHome === 'true') {
    const syncScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    };
    syncScroll();
    window.addEventListener('scroll', syncScroll, { passive: true });
  }

  const menuToggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const mobilePanel = document.getElementById('mobile-nav-panel');
  if (menuToggle && mobilePanel) {
    menuToggle.addEventListener('click', () => {
      const nextOpen = mobilePanel.hidden;
      mobilePanel.hidden = !nextOpen;
      menuToggle.setAttribute('aria-expanded', String(nextOpen));
      menuToggle.setAttribute('aria-label', nextOpen ? 'メニューを閉じる' : 'メニューを開く');
    });
  }
</script>
