---
---

<div
  id="search-modal"
  class="search-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-modal-title"
  hidden
  data-pagefind-ignore
>
  <div class="search-backdrop" data-search-close></div>
  <div class="search-panel" role="document">
    <div class="search-header">
      <label id="search-modal-title" for="search-input" class="sr-only">サイト内検索</label>
      <svg
        class="search-icon"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
      <input
        id="search-input"
        type="search"
        class="search-input"
        placeholder="章・API・エラーコードを検索（例: request, locator, CACHE_MISS）"
        autocomplete="off"
        spellcheck="false"
      />
      <button type="button" class="search-close-btn" data-search-close aria-label="検索を閉じる">
        Esc
      </button>
    </div>

    <div class="search-body">
      <p id="search-status" class="search-status" aria-live="polite">
        キーワードを入力して教材全体を検索できます（模範解答のネタバレは検索対象外です）。
      </p>
      <ul id="search-results" class="search-results" role="listbox" aria-label="検索結果"></ul>
    </div>
  </div>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1rem, 6vh, 4rem) 1rem 1rem;
  }

  .search-overlay[hidden] {
    display: none;
  }

  .search-backdrop {
    position: fixed;
    inset: 0;
    background-color: var(--modal-backdrop);
  }

  .search-panel {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 40rem;
    max-height: min(76vh, 38rem);
    display: flex;
    flex-direction: column;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-hairline);
    border-radius: 6px;
    overflow: hidden;
  }

  .search-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border-hairline);
    background-color: var(--bg-surface);
  }

  .search-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .search-input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    background-color: transparent;
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: var(--text-body);
    line-height: 1.5;
    padding: 0.25rem 0;
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-input:focus {
    outline: none;
  }

  .search-close-btn {
    flex-shrink: 0;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--border-hairline);
    border-radius: 4px;
    background-color: var(--bg-elevated);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: color 160ms var(--ease-precision), border-color 160ms var(--ease-precision);
  }

  .search-close-btn:hover {
    color: var(--text-primary);
    border-color: var(--text-muted);
  }

  .search-body {
    flex: 1 1 auto;
    overflow-y: auto;
    padding: 0.75rem 1rem 1rem;
  }

  .search-status {
    margin: 0 0 0.75rem;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .search-results :global(.search-result-item) {
    border-top: 1px solid var(--border-hairline);
  }

  .search-results :global(.search-result-link) {
    display: block;
    padding: 0.75rem 0.5rem;
    text-decoration: none;
    transition: background-color 140ms var(--ease-precision);
  }

  .search-results :global(.search-result-link:hover),
  .search-results :global(.search-result-link:focus-visible) {
    background-color: var(--bg-surface);
  }

  .search-results :global(.search-result-title) {
    display: block;
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .search-results :global(.search-result-excerpt) {
    display: block;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--text-muted);
  }

  .search-results :global(mark) {
    background-color: var(--accent-subtle);
    color: var(--accent);
    font-weight: 600;
    padding: 0 0.15rem;
    border-radius: 2px;
  }
</style>

<script>
  interface PagefindResultData {
    url: string;
    meta?: { title?: string };
    excerpt?: string;
  }

  interface PagefindModule {
    init?: () => Promise<void>;
    search: (query: string) => Promise<{
      results: Array<{ data: () => Promise<PagefindResultData> }>;
    }>;
  }

  const modal = document.getElementById('search-modal');
  const input = document.getElementById('search-input') as HTMLInputElement | null;
  const statusEl = document.getElementById('search-status');
  const resultsEl = document.getElementById('search-results');

  let pagefind: PagefindModule | null = null;
  let pagefindUnavailable = false;
  let lastFocused: HTMLElement | null = null;
  let debounceTimer: number | undefined;
  let searchSeq = 0;

  async function ensurePagefind(): Promise<PagefindModule | null> {
    if (pagefind) return pagefind;
    if (pagefindUnavailable) return null;
    try {
      const p = '/pagefind/pagefind.js';
      const mod = (await import(/* @vite-ignore */ p)) as PagefindModule;
      if (typeof mod.init === 'function') {
        await mod.init();
      }
      pagefind = mod;
      return pagefind;
    } catch {
      pagefindUnavailable = true;
      return null;
    }
  }

  function getFocusableElements(container: HTMLElement): HTMLElement[] {
    const selectors = [
      'a[href]',
      'button:not([disabled])',
      'input:not([disabled])',
      '[tabindex]:not([tabindex="-1"])',
    ].join(', ');
    return Array.from(container.querySelectorAll<HTMLElement>(selectors)).filter(
      (el) => el.offsetParent !== null,
    );
  }

  function openSearch() {
    if (!modal || !input) return;
    lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    input.focus();
    input.select();
    void ensurePagefind();
  }

  function closeSearch() {
    if (!modal) return;
    modal.hidden = true;
    document.body.style.overflow = '';
    if (lastFocused) {
      lastFocused.focus();
      lastFocused = null;
    }
  }

  function renderPlainMessage(message: string) {
    if (statusEl) statusEl.textContent = message;
    if (resultsEl) resultsEl.innerHTML = '';
  }

  async function runSearch(query: string) {
    const trimmed = query.trim();
    if (!trimmed) {
      renderPlainMessage(
        'キーワードを入力して教材全体を検索できます（模範解答のネタバレは検索対象外です）。',
      );
      return;
    }

    const currentSeq = ++searchSeq;
    const pf = await ensurePagefind();
    if (currentSeq !== searchSeq) return;

    if (!pf) {
      renderPlainMessage(
        '検索インデックスはビルド後（pnpm build）に有効になります。開発中はカリキュラムやエラー逆引きから探してください。',
      );
      return;
    }

    if (statusEl) statusEl.textContent = '検索中...';
    const response = await pf.search(trimmed);
    if (currentSeq !== searchSeq) return;

    const topItems = response.results.slice(0, 10);
    if (topItems.length === 0) {
      renderPlainMessage(`「${trimmed}」に一致するページが見つかりませんでした。`);
      return;
    }

    const resolved = await Promise.all(topItems.map((item) => item.data()));
    if (currentSeq !== searchSeq) return;

    if (statusEl) {
      statusEl.textContent = `${response.results.length} 件ヒット（上位 ${resolved.length} 件を表示）`;
    }
    if (!resultsEl) return;

    resultsEl.innerHTML = '';
    for (const item of resolved) {
      const li = document.createElement('li');
      li.className = 'search-result-item';

      const link = document.createElement('a');
      link.className = 'search-result-link';
      link.href = item.url;

      const title = document.createElement('span');
      title.className = 'search-result-title';
      title.textContent = item.meta?.title || item.url;

      const excerpt = document.createElement('span');
      excerpt.className = 'search-result-excerpt';
      excerpt.innerHTML = item.excerpt || '';

      link.append(title, excerpt);
      li.append(link);
      resultsEl.append(li);
    }
  }

  if (modal && input) {
    for (const trigger of document.querySelectorAll<HTMLElement>('[data-search-open]')) {
      trigger.addEventListener('click', openSearch);
    }

    for (const closer of modal.querySelectorAll<HTMLElement>('[data-search-close]')) {
      closer.addEventListener('click', closeSearch);
    }

    input.addEventListener('input', () => {
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(() => {
        void runSearch(input.value);
      }, 150);
    });

    document.addEventListener('keydown', (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        if (modal.hidden) {
          openSearch();
        } else {
          closeSearch();
        }
        return;
      }

      if (modal.hidden) return;

      if (event.key === 'Escape') {
        event.preventDefault();
        closeSearch();
        return;
      }

      if (event.key === 'Tab') {
        const focusables = getFocusableElements(modal);
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
